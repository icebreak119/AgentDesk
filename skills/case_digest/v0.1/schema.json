    "properties": {
      "case_id": { "type": "string" },
      "intent": { "type": "string" },
      "risk_tag": { "type": "string" },
      "resolution": { "type": "string" },
      "knowledge_snippet": { "type": "string" },
      "privacy": { "type": "object" }
    }
  }
}
