{
  "skill": "CustomerConfirm",
  "version": "0.1",
  "input": {
    "type": "object",
    "required": ["task_id"],
    "properties": {
      "task_id": { "type": "string" },
      "customer_feedback": { "type": "string" }
    }
  },
  "output": {
    "type": "object",
    "required": ["confirmation_state", "needs_follow_up", "feedback_summary", "evidence_ref"],
    "properties": {
      "confirmation_state": { "type": "string", "enum": ["confirmed", "needs_follow_up", "awaiting_feedback"] },
      "needs_follow_up": { "type": "boolean" },
      "feedback_summary": { "type": "string" },
      "evidence_ref": { "type": "string" }
    }
  }
}
